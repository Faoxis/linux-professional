### Управляется ansible. Права 0600, владелец root.
### Читается юнитом borg-backup.service через EnvironmentFile.

BORG_REPO={{ borg_repo }}
BORG_PASSPHRASE={{ borg_passphrase }}

BACKUP_TARGET={{ backup_target }}
KEEP_DAILY={{ keep_daily }}
KEEP_MONTHLY={{ keep_monthly }}

# Значение с пробелами обязательно в кавычках. systemd их снимает сам,
# а без них файл нельзя просто взять и выполнить через source в шелле:
# bash разберёт строку как присваивание плюс команду.
BORG_RSH="{{ borg_rsh }}"
