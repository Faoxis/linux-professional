      "index": "a026",
      "roundness": null,
      "seed": 655266947,
      "version": 1,
      "versionNonce": 363756577,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "напрямую, без туннеля     3.12 Гбит/с\nчерез tun                  326 Мбит/с\nчерез tap                  312 Мбит/с\n                (среднее по 8 проходам)",
      "originalText": "напрямую, без туннеля     3.12 Гбит/с\nчерез tun                  326 Мбит/с\nчерез tap                  312 Мбит/с\n                (среднее по 8 проходам)",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el26",
      "type": "text",
      "x": 560,
      "y": 406,
      "width": 198.0,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a027",
      "roundness": null,
      "seed": 265502698,
      "version": 1,
      "versionNonce": 921587362,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "пинг 1000 байт данных,\nразмер udp наружу:\n  tun   1068 байт\n  tap   1084 байт",
      "originalText": "пинг 1000 байт данных,\nразмер udp наружу:\n  tun   1068 байт\n  tap   1084 байт",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el27",
      "type": "text",
      "x": 84,
      "y": 490,
      "width": 578.76,
      "height": 70.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a028",
      "roundness": null,
      "seed": 2061400755,
      "version": 1,
      "versionNonce": 1669179613,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "tap несёт ещё и ethernet-заголовок, поэтому на проводе он на 16 байт длиннее.\nИз-за этого он и медленнее, но всего на единицы процентов: на отдельном замере\nразница тонет в разбросе, видно её только усреднением по нескольким проходам.\nПадение же с гигабит до сотен мегабит даёт шифрование, а не выбор tun или tap.",
      "originalText": "tap несёт ещё и ethernet-заголовок, поэтому на проводе он на 16 байт длиннее.\nИз-за этого он и медленнее, но всего на единицы процентов: на отдельном замере\nразница тонет в разбросе, видно её только усреднением по нескольким проходам.\nПадение же с гигабит до сотен мегабит даёт шифрование, а не выбор tun или tap.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
