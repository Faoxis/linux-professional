### Управляется ansible, роль postgres_replication.

# --- Расположение файлов кластера ---
# В методичке этих строк нет, она писалась под сборку с одним каталогом данных.
# В Debian/Ubuntu конфиги лежат в /etc, данные в /var/lib, и pg_ctlcluster берёт
# путь к каталогу данных именно отсюда. Без них кластер не стартует.
data_directory = '{{ pg_data_dir }}'
hba_file = '{{ pg_conf_dir }}/pg_hba.conf'
ident_file = '{{ pg_conf_dir }}/pg_ident.conf'
external_pid_file = '/var/run/postgresql/{{ pg_version }}-main.pid'
unix_socket_directories = '/var/run/postgresql'
cluster_name = '{{ pg_version }}/main'
stats_temp_directory = '/var/run/postgresql/{{ pg_version }}-main.pg_stat_tmp'
ssl = on
ssl_cert_file = '/etc/ssl/certs/ssl-cert-snakeoil.pem'
ssl_key_file = '/etc/ssl/private/ssl-cert-snakeoil.key'
shared_buffers = 128MB
dynamic_shared_memory_type = posix

# --- Подключения ---
# Указываем ip-адреса, на которых postgres будет слушать трафик на порту 5432
listen_addresses = 'localhost, {{ pg_listen_ip }}'
# Указываем порт postgres
port = 5432
# Устанавливаем максимально 100 одновременных подключений
max_connections = 100

# --- Журналирование ---
log_directory = 'log'
log_filename = 'postgresql-%a.log'
log_rotation_age = 1d
log_rotation_size = 0
log_truncate_on_rotation = on
log_line_prefix = '%m [%p] '

# --- WAL и репликация ---
max_wal_size = 1GB
min_wal_size = 80MB
# Можно или нет подключаться к postgresql для выполнения запросов
# в процессе восстановления
hot_standby = on
# Включаем репликацию
wal_level = replica
# Количество планируемых слейвов
max_wal_senders = 3
# Максимальное количество слотов репликации:
# один под реплику node2, один под barman
max_replication_slots = 3
# Будет ли сервер slave сообщать мастеру о запросах, которые он выполняет
hot_standby_feedback = on

# --- Локаль и время ---
# Указываем часовой пояс для Москвы
log_timezone = 'UTC+3'
timezone = 'UTC+3'
datestyle = 'iso, mdy'
lc_messages = 'en_US.UTF-8'
lc_monetary = 'en_US.UTF-8'
lc_numeric = 'en_US.UTF-8'
lc_time = 'en_US.UTF-8'
default_text_search_config = 'pg_catalog.english'

# Включаем использование зашифрованных паролей
password_encryption = scram-sha-256
