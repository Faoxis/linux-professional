#!/bin/bash
#
# Стук по портам: отправляет SYN на заданные порты в нужном порядке,
# после чего inetRouter на минуту открывает для нас ssh.
#
# Порты на той стороне закрыты через DROP, ответа не будет, поэтому
# каждому nc даём таймаут в секунду и не смотрим на код возврата -
# важен сам факт прихода пакета.

set -u

HOST="${1:-{{ inet_router_ip }}}"
PORTS=({{ knock_ports | join(' ') }})

echo "стучимся на ${HOST}: ${PORTS[*]}"
for port in "${PORTS[@]}"; do
    nc -z -w 1 "${HOST}" "${port}" >/dev/null 2>&1
    echo "  -> ${port}"
    sleep 1
done
echo "последовательность отправлена, ssh на ${HOST} открыт ~{{ knock_open_seconds }} секунд"
