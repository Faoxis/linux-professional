### Управляется ansible. centralServer: веб-сервер, наружу торчит только nginx.

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Управляющий интерфейс vagrant - первым правилом
-A INPUT -i eth0 -j ACCEPT
-A INPUT -i lo -j ACCEPT

-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -p icmp -j ACCEPT

# ssh из сети стенда и собственно веб
-A INPUT -i eth1 -p tcp --dport 22 -m conntrack --ctstate NEW -j ACCEPT
-A INPUT -i eth1 -p tcp --dport {{ backend_port }} -m conntrack --ctstate NEW -j ACCEPT

COMMIT

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
COMMIT
