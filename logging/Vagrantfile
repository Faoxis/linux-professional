# Описание параметров ВМ
MACHINES = {
  # центральный сервер сбора логов
  :log => {
    :box_name => "bento/ubuntu-22.04",
    :cpus     => 1,
    :memory   => 1024,
    :ip       => "192.168.56.15",
  },
  # веб-сервер, источник логов
  :web => {
    :box_name => "bento/ubuntu-22.04",
    :cpus     => 1,
    :memory   => 1024,
    :ip       => "192.168.56.10",
  },
}

Vagrant.configure("2") do |config|

  MACHINES.each do |boxname, boxconfig|

    config.vm.define boxname do |box|

      box.vm.box = boxconfig[:box_name]
      box.vm.host_name = boxname.to_s
      box.vm.network "private_network", ip: boxconfig[:ip]

      box.vm.provider "virtualbox" do |v|
        v.memory = boxconfig[:memory]
        v.cpus = boxconfig[:cpus]
      end

      # Плейбук запускается один раз, на последней машине и сразу на обе:
      # лог-сервер должен быть настроен раньше, чем web начнёт слать,
      # а порядок плеев внутри плейбука это гарантирует.
      if boxname == :web
        box.vm.provision "ansible" do |ansible|
          ansible.playbook = "ansible/provision.yml"
          ansible.host_key_checking = "false"
          ansible.limit = "all"
          ansible.groups = {
            "logserver" => ["log"],
            "webserver" => ["web"],
          }
        end
      end
    end
  end
end
