### Управляется ansible. Отправка логов на центральный сервер.

# Критичные сообщения дублируем в отдельный локальный файл: по условию
# они должны быть и локально, и на удалённом сервере.
*.crit                          {{ critical_log }}

# Всё остальное уезжает на лог-сервер. Две "@" - это TCP: доставка
# с подтверждением, в отличие от одной "@" (UDP).
# Очередь на диске нужна, чтобы при недоступном лог-сервере сообщения
# копились, а не терялись, и уехали, когда он вернётся.
action(type="omfwd"
       target="{{ log_ip }}" port="{{ syslog_port }}" protocol="tcp"
       queue.type="linkedlist"
       queue.filename="fwd_{{ log_ip | replace('.', '_') }}"
       queue.maxdiskspace="100m"
       queue.saveonshutdown="on"
       action.resumeRetryCount="-1")
