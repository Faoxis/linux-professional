# Имя машины в vagrant короткое, а имя хоста внутри системы - полное:
# FreeIPA требует FQDN, но набирать "vagrant ssh ipa.otus.lan" неудобно.
MACHINES = {
  :ipa => {
    :hostname => "ipa.otus.lan",
    :ip       => "192.168.57.10",
    # FreeIPA тянет за собой 389-DS, Kerberos, PKI и Apache:
    # на 2 ГБ установка упирается в память
    :memory   => 4096,
    :cpus     => 2,
  },
  :client1 => {
    :hostname => "client1.otus.lan",
    :ip       => "192.168.57.11",
    :memory   => 1024,
    :cpus     => 1,
  },
  :client2 => {
    :hostname => "client2.otus.lan",
    :ip       => "192.168.57.12",
    :memory   => 1024,
    :cpus     => 1,
  },
}

Vagrant.configure("2") do |config|
  # Методичка написана под centos/stream8. Он снят с поддержки в мае 2024,
  # зеркала уехали в архив и yum на голом боксе не отработает.
  # AlmaLinux 9 - тот же RHEL-совместимый дистрибутив с живыми репозиториями.
  config.vm.box = "almalinux/9"

  MACHINES.each do |boxname, boxconfig|
    config.vm.define boxname do |box|
      box.vm.hostname = boxconfig[:hostname]
      box.vm.network "private_network", ip: boxconfig[:ip]

      box.vm.provider :virtualbox do |v|
        v.memory = boxconfig[:memory]
        v.cpus = boxconfig[:cpus]
      end

      # Плейбук запускается один раз, на последней машине и сразу на все:
      # клиенты записываются в домен на сервере, поэтому он должен быть готов
      # раньше, а порядок плеев это обеспечивает.
      if boxname == MACHINES.keys.last
        box.vm.provision "ansible" do |ansible|
          ansible.playbook = "ansible/provision.yml"
          ansible.host_key_checking = "false"
          ansible.limit = "all"
          ansible.groups = {
            "server"  => ["ipa"],
            "clients" => ["client1", "client2"],
          }
        end
      end
    end
  end
end
