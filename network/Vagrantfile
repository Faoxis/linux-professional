# Адаптер N в vagrant соответствует интерфейсу eth(N-1) в госте.
# eth0 везде занят под NAT, который поднимает сам vagrant.
MACHINES = {
  :inetRouter => {
    :net => [
      ["192.168.255.1",  2, "255.255.255.252", "router-net"],
    ]
  },

  :centralRouter => {
    :net => [
      ["192.168.255.2",  2, "255.255.255.252", "router-net"],
      ["192.168.0.1",    3, "255.255.255.240", "dir-net"],
      ["192.168.0.33",   4, "255.255.255.240", "hw-net"],
      ["192.168.0.65",   5, "255.255.255.192", "mgt-net"],
      ["192.168.255.9",  6, "255.255.255.252", "office1-central"],
      ["192.168.255.5",  7, "255.255.255.252", "office2-central"],
    ]
  },

  :centralServer => {
    :net => [
      ["192.168.0.2",    2, "255.255.255.240", "dir-net"],
    ]
  },

  :office1Router => {
    :net => [
      ["192.168.255.10", 2, "255.255.255.252", "office1-central"],
      ["192.168.2.1",    3, "255.255.255.192", "dev1-net"],
      ["192.168.2.65",   4, "255.255.255.192", "test1-net"],
      ["192.168.2.129",  5, "255.255.255.192", "managers-net"],
      ["192.168.2.193",  6, "255.255.255.192", "office1-net"],
    ]
  },

  :office1Server => {
    :net => [
      ["192.168.2.130",  2, "255.255.255.192", "managers-net"],
    ]
  },

  :office2Router => {
    :net => [
      ["192.168.255.6",  2, "255.255.255.252", "office2-central"],
      ["192.168.1.1",    3, "255.255.255.128", "dev2-net"],
      ["192.168.1.129",  4, "255.255.255.192", "test2-net"],
      ["192.168.1.193",  5, "255.255.255.192", "office2-net"],
    ]
  },

  :office2Server => {
    :net => [
      ["192.168.1.2",    2, "255.255.255.128", "dev2-net"],
    ]
  },
}

Vagrant.configure("2") do |config|
  MACHINES.each do |boxname, boxconfig|
    config.vm.define boxname do |box|
      box.vm.box = "bento/ubuntu-22.04"
      box.vm.host_name = boxname.to_s

      box.vm.provider "virtualbox" do |v|
        v.memory = 768
        v.cpus = 1
      end

      boxconfig[:net].each do |ip, adapter, netmask, intnet|
        box.vm.network "private_network",
          ip: ip, adapter: adapter, netmask: netmask, virtualbox__intnet: intnet
      end

      # Ansible запускаем один раз, когда поднялась последняя машина,
      # иначе он стартовал бы после каждой и падал на ещё не созданных хостах.
      if boxname == MACHINES.keys.last
        box.vm.provision "ansible" do |ansible|
          ansible.playbook = "ansible/provision.yml"
          ansible.host_key_checking = "false"
          ansible.limit = "all"
          ansible.groups = {
            "routers" => ["inetRouter", "centralRouter", "office1Router", "office2Router"],
            "servers" => ["centralServer", "office1Server", "office2Server"],
          }
        end
      end
    end
  end
end
